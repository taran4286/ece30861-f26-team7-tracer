# Copy to .env and fill in real values. Never commit .env.
# Hosts are 127.0.0.1, not localhost: the Docker port is published on IPv4
# loopback only, and localhost can resolve to ::1 first.

# Local Docker database: docker compose reads these. POSTGRES_USER is the owner role.
POSTGRES_DB=tracer
POSTGRES_USER=tracer_owner
POSTGRES_PASSWORD=change-me-owner

# Owner role: scripts/setup_db.py only. Never set this on the running service.
ADMIN_DATABASE_URL=postgresql+psycopg://tracer_owner:change-me-owner@127.0.0.1:5432/tracer

# App role: the service and tests. setup_db.py creates it with this password.
DATABASE_URL=postgresql+psycopg://tracer_app:change-me-app@127.0.0.1:5432/tracer

# Domestic or FPI
REGISTRANT_TYPE=Domestic
